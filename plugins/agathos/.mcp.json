{
  "mcpServers": {
    "agathos": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server.js"],
      "env": {
        "AGATHOS_TOKEN": "${AGATHOS_TOKEN:-}",
        "AGATHOS_TOKEN_FILE": "${AGATHOS_TOKEN_FILE:-}",
        "AGATHOS_PORT": "${AGATHOS_PORT:-47612}"
      }
    }
  }
}

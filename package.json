{
  "name": "agathos-os",
  "productName": "AgathOS",
  "version": "0.11.0",
  "description": "The good daemon for your local AI agents. Finds rogue agents, poisoned MCP servers and hidden instructions on Windows and macOS.",
  "main": "main.js",
  "license": "MIT",
  "author": "AgathOS contributors",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "npx --yes electron-builder@26 --win nsis --x64",
    "dist:mac": "npx --yes electron-builder@26 --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^44.0.0"
  },
  "agathos": {
    "updateRepo": "laaielichter/AgathOS"
  },
  "build": {
    "appId": "io.agathos.app",
    "productName": "AgathOS",
    "copyright": "AgathOS contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "guard/**",
      "plugins/**",
      "src/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "guard/**",
      "plugins/**"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AgathOS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AgathOS",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "nl_NL",
        "de_DE",
        "fr_FR",
        "es_ES",
        "pt_BR",
        "ru_RU",
        "zh_CN",
        "ja_JP",
        "ko_KR",
        "id_ID",
        "ar_SA"
      ],
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "AgathOS-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "AgathOS checks instruction files, MCP settings and API keys in your projects.",
        "NSDesktopFolderUsageDescription": "AgathOS checks instruction files, MCP settings and API keys in your projects.",
        "NSDownloadsFolderUsageDescription": "AgathOS checks downloaded models and repos for hidden instructions and unsafe code."
      }
    },
    "dmg": {
      "title": "AgathOS ${version}"
    }
  }
}

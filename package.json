{
  "name": "agathos-os",
  "productName": "AgathOS",
  "version": "0.3.0",
  "description": "The good daemon for your local AI agents. Finds rogue agents, poisoned MCP servers and hidden instructions on Windows.",
  "main": "main.js",
  "license": "MIT",
  "author": "AgathOS contributors",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "npx --yes electron-builder@26 --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0"
  },
  "build": {
    "appId": "io.agathos.app",
    "productName": "AgathOS",
    "copyright": "AgathOS contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "guard/**",
      "src/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "guard/**"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AgathOS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AgathOS",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "nl_NL",
        "de_DE",
        "fr_FR",
        "es_ES",
        "pt_BR",
        "ru_RU",
        "zh_CN",
        "ja_JP",
        "ko_KR",
        "id_ID",
        "ar_SA"
      ],
      "deleteAppDataOnUninstall": false
    }
  }
}
